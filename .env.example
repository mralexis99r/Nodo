PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/nodo.sqlite
# Set DATABASE_URL to use PostgreSQL (Neon). Required in production; leave blank for local SQLite.
DATABASE_URL=
# Set NODE_ENV=production in the hosting environment when deploying.
# Set only behind a trusted reverse proxy, for example 1 for one proxy hop.
TRUST_PROXY=0

# Cloud email: use Brevo HTTPS API on hosts that block SMTP ports.
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Nodo
# SMTP remains available for local use or compatible hosts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_CODE_SECRET=
